  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "subagents",
    "local-llm",
    "small-models",
    "context-window"
  ],
  "license": "MIT",
  "author": "JonyPlo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JonyPlo/pi-little-subagents.git"
  },
  "homepage": "https://github.com/JonyPlo/pi-little-subagents#readme",
  "bugs": {
    "url": "https://github.com/JonyPlo/pi-little-subagents/issues"
  },
  "files": [
    "extensions",
    "agents",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/subagent.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
